

# ---------- Pretty URLs ----------
RewriteEngine On

# Redirect /index to homepage
RewriteRule ^index/?$ / [R=301,L]

# Make homepage load index.html
DirectoryIndex index.html

# Hide .html extension for ALL pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Optional custom page
RewriteRule ^AboutUS/?$ about-us.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
